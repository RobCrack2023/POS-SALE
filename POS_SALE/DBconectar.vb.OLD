    Dim connmysql As MySqlConnection

    ' Public connstr As String = "server=localhost;user id='root'; password='std2018**.*'; database=pos_sale; pooling=false"
    Public connstr As String = "server=localhost;user id='root'; password=''; database=pos_sale; pooling=false"
    'Public connstr As String = "server='192.168.1.171';user id='root'; password=''; database=pos_std; pooling=false"
    'Public connstr2 As String = "server='186.103.191.226';user id='rob';port=8506; password='123456'; database=pos_std; pooling=false"
